{
  "permissions": {
    "allow": [
      "Bash(ruff check *)",
      "Bash(ruff check --fix *)",
      "Bash(pytest *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status)",
      "Bash(npx gitnexus *)",
      "Bash(gitnexus *)",
      "Edit(docs/**)",
      "Edit(specs/**)",
      "Edit(.claude/docs/**)",
      "Edit(.claude/steering/**)",
      "Edit(.claude/memory/**)",
      "Edit(**/*.md)",
      "Write(**/*.md)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/prompt-hook.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/frontend-security-nudge.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/memory-discipline-hook.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/protected-path-hook.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/skill-validate-hook.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-tool-use-gitnexus.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gbrain-agent-spawn.sh"
          }
        ]
      },
      {
        "matcher": "mcp__plugin_claude-mem_mcp-search__save_observation",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gbrain-memory-write.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gbrain-external-search.sh"
          }
        ]
      },
      {
        "matcher": "mcp__raindrop__",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/raindrop-best-practices.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-failure-recall.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/impeccable-detect-hook.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/hook-added-notify.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/lean-ctx-nudge-hook.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/revert-detect-hook.sh"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ccr-routine-added-notify.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/compaction-discipline-hook.sh"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tool-failure-capture.sh"
          }
        ]
      }
    ]
  }
}

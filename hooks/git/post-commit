#!/usr/bin/env bash
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
TODAY=$(date +%Y-%m-%d)

CHANGED=$(git diff HEAD~1 --name-only 2>/dev/null)
if [ -z "$CHANGED" ]; then exit 0; fi

# ── Recursion guard: never react to this hook's OWN auto-sync commits ─────────
# Hook 3 below commits doc updates as "docs: auto-sync (…)". Watched dirs include
# skills/ and hooks/, so such a commit would otherwise re-fire the agents and
# loop. Bail immediately when the just-made commit is one of ours.
case "$(git log -1 --format=%s 2>/dev/null)" in
  "docs: auto-sync"*) exit 0 ;;
esac

# ── Hook 0: GitNexus auto-reindex (keep knowledge graph fresh) ───────────────
# Runs only when GitNexus is installed and the repo is indexed.
# Incremental reindex is fast (<5s for most repos), so it runs on every commit.
if [ -d "$REPO_ROOT/.gitnexus" ]; then
  if command -v gitnexus >/dev/null 2>&1 || npx gitnexus --version >/dev/null 2>&1; then
    (cd "$REPO_ROOT" && npx gitnexus analyze --skip-embeddings >/dev/null 2>&1 </dev/null) &
    echo "  post-commit: GitNexus reindex running in background..."
  fi
fi

# ── Hook 1: Doc sync (documentation drift prevention) ────────────────────────
# Skip if only .md files changed (avoid infinite loop if docs are committed)
NON_MD=$(echo "$CHANGED" | grep -v '\.md$' | grep -v '\.claude/')
if [ -n "$NON_MD" ]; then
  DOC_SYNC_PROMPT="The following source files changed in the last git commit:
$NON_MD

Your task: find ALL .md files in the repo that document behavior affected by these changes.
Use: find $REPO_ROOT -name '*.md' -not -path '*/.venv/*' -not -path '*/.git/*' -not -path '*/__pycache__/*' -not -path '*/.claude/*'

Determine relevance using these rules (apply in order, stop at first match):
- Filename match: stem of changed file appears in the .md filename
- Content keyword match: stem of changed file appears in a heading in the .md file
- Topic match: changed file alters how a feature works, and .md describes that feature
- No match: do not update

For EACH relevant .md file:
- Read it, then update only the sections directly affected by the code changes
- Do not remove content unless it directly contradicts what changed
- Do not restructure or reformat unrelated sections
- Replace any existing '_Last synced' line with: _Last synced: ${TODAY}_

Skip .md files inside .venv/, .git/, and .claude/. Never write to source code files."

fi

# ── Hook 2: Harness updater (SDD-SETUP-GUIDE sync) ──────────────────────────
HARNESS_CHANGED=$(echo "$CHANGED" | grep -E '^(agents|commands|hooks|kiro|scripts|rules|templates|skills)/|^CLAUDE\.md$')
if [ -n "$HARNESS_CHANGED" ]; then
  HARNESS_PROMPT="The following Claude Code harness files were modified in the last git commit:
$HARNESS_CHANGED

Your task: update docs/harness-documentation/SDD-SETUP-GUIDE.md to reflect these changes.
- New or modified command file (commands/) → update the slash commands section
- New or modified agent file (agents/) → update the subagents section
- CLAUDE.md changed → update the project constitution section
- New or modified skill (skills/) → update or add a skills section
- Modified hook (hooks/) → update the automated hooks section
- New or modified kiro settings (kiro/) → update the rules/templates section
- Modified context rules (rules/) → update the context-engineering section
- Modified settings template (templates/settings*.template) → update the hooks/configuration section
Do not remove existing documented steps unless directly replaced by the changes.
Do not overwrite sections unrelated to the detected changes.
Replace any existing '_Last synced' line with: _Last synced: ${TODAY}_"

fi

# ── Hook 3: Detached runner — sync docs, then auto-commit + push .md only ────
# Runs as ONE fully-detached background job so `git commit` returns immediately
# and the terminal is freed (no hang, no Ctrl-C). stdin ← /dev/null and all
# output → a log keep it off the tty; `timeout` (if present) bounds each agent
# so a stuck `claude` can never block. The .md-only commit it makes re-triggers
# this hook, but the self-commit guard at the top ("docs: auto-sync") exits it.
if [ -n "$NON_MD" ] || [ -n "$HARNESS_CHANGED" ]; then
  LOG="$REPO_ROOT/.git/post-commit-docsync.log"
  TIMEOUT_BIN=""
  command -v timeout  >/dev/null 2>&1 && TIMEOUT_BIN="timeout 900"
  [ -z "$TIMEOUT_BIN" ] && command -v gtimeout >/dev/null 2>&1 && TIMEOUT_BIN="gtimeout 900"
  {
    # Serialize concurrent runs (rapid commits each spawn one). mkdir is atomic;
    # if another run holds the lock, skip — prevents git-index races that drop
    # commits and stops agent pile-up. Steal a lock left stale for >30 min.
    LOCKDIR="$REPO_ROOT/.git/post-commit-docsync.lock"
    [ -d "$LOCKDIR" ] && [ -n "$(find "$LOCKDIR" -maxdepth 0 -mmin +30 2>/dev/null)" ] && rmdir "$LOCKDIR" 2>/dev/null
    if ! mkdir "$LOCKDIR" 2>/dev/null; then
      echo "=== skipped $(date): another doc-sync run is active ==="
      exit 0
    fi
    trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT
    echo "=== doc-sync run $(date) ==="
    [ -n "$NON_MD" ]          && { $TIMEOUT_BIN claude --dangerously-skip-permissions --print "$DOC_SYNC_PROMPT" || true; }
    [ -n "$HARNESS_CHANGED" ] && { $TIMEOUT_BIN claude --dangerously-skip-permissions --print "$HARNESS_PROMPT" || true; }
    cd "$REPO_ROOT" || exit 0
    if [ -n "$(git status --porcelain -- '*.md')" ]; then
      git add -- '*.md'
      git commit -m "docs: auto-sync ($TODAY)" -- '*.md' \
        && { git push && echo "  .md auto-committed and pushed" \
             || echo "  .md committed but push failed (check remote/auth)"; }
    else
      echo "  no .md changes to commit"
    fi
    echo "=== done $(date) ==="
  } </dev/null >>"$LOG" 2>&1 &
  disown 2>/dev/null || true
  echo "  post-commit: doc-sync + auto-push running in background (log: .git/post-commit-docsync.log)"
fi

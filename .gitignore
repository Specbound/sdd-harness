# Local machine state — never commit
projects.txt
VERSION

# Channel webhook credentials — belt-and-suspenders (real file lives in ~/)
*.env.channels
channels.env

# Runtime artifacts
logs/
.dashboard/
__pycache__/
*.pyc

# Harness-owned tool venv (liteparse etc.) — built by scripts/setup/liteparse-setup.sh
.venv-tools/

# Platform-compiled skill deps — reinstall per machine (npm install), never vendor binaries
skills/pptx-official/node_modules/

# Tool-generated files — runtime state, not source
headroom_memory.db
/LEAN-CTX.md
.superpowers/
docs/workflow/superpowers/
.last-drift-review
.headroom/

# ── Installed harness output — NEVER commit ──────────────────────────────────
# Single source of truth is the TOP-LEVEL source tree (agents/ commands/ hooks/
# kiro/ scripts/ docs/ rules/ skills/ templates/). install.sh / update.sh rebuild
# .claude/ from it on every machine, so .claude/ is regenerable output, not
# source. Per-machine settings.json + memory content also live here and stay
# local. Already-tracked .claude/memory/**/.gitkeep persist as clone scaffolding.
.claude/
specs/

# SDD harness — local-only, never committed
CLAUDE.md

# Serena symbol index — regenerable per machine via `serena project index`
.serena/

# Tool-written backups (e.g. `lean-ctx setup` saving the prior AGENTS.md).
# Git history is the backup — a .bak in the tree is a second source of truth.
*.bak

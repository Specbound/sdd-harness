# Local machine state — never commit
projects.txt
VERSION
.claude/settings.json
.claude/docs/superpowers/

# Channel webhook credentials — belt-and-suspenders (real file lives in ~/)
*.env.channels
channels.env

# Per-user memory — stays local, never shared
.claude/memory/**
!.claude/memory/daily/
!.claude/memory/glacier/
!.claude/memory/meta/
!.claude/memory/.gitkeep
!.claude/memory/**/.gitkeep

# Runtime artifacts
logs/
.dashboard/
__pycache__/
*.pyc

# Harness-owned tool venv (liteparse etc.) — built by scripts/setup/liteparse-setup.sh
.venv-tools/

# Tool-generated files — runtime state, not source
headroom_memory.db
LEAN-CTX.md
.superpowers/
docs/workflow/superpowers/
.last-drift-review
.headroom/

# SDD harness — local-only, never committed
.claude/
specs/
CLAUDE.md
